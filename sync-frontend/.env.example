# Google OAuth Client ID (required for login)
# Create credentials at https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here

# Client-side Syncthing instance (the device being connected)
# URL of the client Syncthing REST API
VITE_SYNCTHING_URL=http://localhost:8384
# API key of the client Syncthing (see sync-client/.env)
VITE_SYNCTHING_API_KEY=your_client_syncthing_api_key_here

# Backend server URL (use IP when server is on another device)
# Dev: used by vite proxy. Docker: used by nginx proxy (runtime, no rebuild needed).
VITE_API_URL=http://localhost:5000